# Local development overrides for the API. Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# `.env` is git-ignored and must stay that way. This file — `.env.example` — is
# committed and must therefore never contain a real credential.
#
# Spring Boot reads `.env` automatically via `spring.config.import` in
# application.yml, so there is nothing to export and nothing to source. Paste,
# save, restart the service.
#
# Deployed environments do NOT use this file. They supply the same names through the
# environment or the bank's secret manager.


# ----------------------------------------------------------------- email (SMTP)

# Turn sending on. Leave false and nothing is sent: verification codes are written to
# the log instead, which is enough to walk the registration flow without a mailbox.
MAIL_ENABLED=false

# Gmail's submission endpoint. 587 is STARTTLS, which is what application.yml requires.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# The full address of the sending account.
MAIL_USERNAME=ciaramuzora@gmail.com

# >>> PASTE THE GOOGLE APP PASSWORD HERE <<<
#
# This is NOT the Google account password — Google stopped accepting those from
# third-party SMTP clients. You need a 16-character App Password:
#
#   1. Turn on 2-Step Verification for the account. App Passwords do not exist without it.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Name it something you will recognise later, e.g. zigama-backend-dev
#   4. Paste the 16 characters below. Spaces are fine to remove; Google shows it in
#      groups of four for readability but it is one 16-character string.
#
# Anything holding this can send mail AS that account, to anyone, including the bank's
# customers. Treat it as a production credential: never commit it, never paste it into
# a chat or a ticket, and revoke it from the same page if it is ever exposed.
MAIL_PASSWORD=

# What customers see in the From field.
MAIL_FROM=ciaramuzora@gmail.com
MAIL_FROM_NAME=Zigama CSS

# How long a verification code stays valid, as an ISO-8601 duration. PT10M is ten minutes.
MAIL_CODE_VALIDITY=PT10M


# ----------------------------------------------------------------- database

# Defaults in application-dev.yml match docker-compose.yml, so these are only needed
# when pointing at something else.
# DB_URL=jdbc:postgresql://localhost:5432/ibanking
# DB_USERNAME=ibanking
# DB_PASSWORD=

# ----------------------------------------------------------------- server

# SERVER_PORT=8080
