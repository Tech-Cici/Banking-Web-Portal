# Copy to .env.local and adjust. .env.local is git-ignored.
#
# Only VITE_-prefixed variables reach the browser, and everything here IS PUBLIC:
# it is inlined into the built JavaScript. Never put a secret, API key, client secret
# or credential in this file or any .env file in this project (blueprint section 24).

# Base URL of the Spring Boot API, without a trailing slash.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Request timeout in milliseconds. Financial submissions that exceed this become
# PENDING CONFIRMATION rather than failures.
VITE_API_TIMEOUT_MS=30000

# Serve the Mock Service Worker instead of calling the real API. Never true in a
# deployed build.
VITE_ENABLE_MOCK_API=false

# Shown in the footer to help support identify which build a customer is running.
VITE_APP_VERSION=0.1.0-dev
