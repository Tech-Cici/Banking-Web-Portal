/* Does the stored balance agree with the last entry? Anything listed here is a bug. */
SELECT a.account_number, a.balance AS account_balance, t.running_balance AS last_entry
FROM accounts a
JOIN transactions t ON t.txn_id = (
        SELECT TOP 1 txn_id FROM transactions
        WHERE account_id = a.account_id ORDER BY posted_at DESC, txn_id DESC)
WHERE a.balance <> t.running_balance;
GO
